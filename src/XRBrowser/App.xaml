<Application x:Class="XRBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:XRBrowser.Converters"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Base.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToHidden" Invert="True" UseHidden="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NotNullToVisibility" Invert="True" />
            <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
            <conv:StringToVisibilityConverter x:Key="EmptyStringToVisibility" Invert="True" />
            <conv:EmptyStringToVisibilityConverter x:Key="ShowWhenEmpty" />
            <conv:EqualityToBoolConverter x:Key="EqualityToBool" />
            <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibility" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
