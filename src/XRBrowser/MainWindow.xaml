<Window x:Class="XRBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="XR Browser"
        Icon="pack://application:,,,/XR;component/Assets/XR.ico"
        Width="1440" Height="900"
        MinWidth="920" MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown"
        Deactivated="Window_Deactivated"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="TabTemplate">
            <Grid x:Name="TabRoot"
                  Height="34"
                  Width="{Binding DataContext.TabWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}, FallbackValue=220}"
                  Margin="0,6,0,0"
                  Background="Transparent"
                  RenderTransformOrigin="0.5,0.5"
                  Loaded="TabRoot_Loaded"
                  ToolTip="{Binding ToolTip}"
                  MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                  MouseMove="Tab_MouseMove"
                  MouseUp="Tab_MouseUp"
                  MouseDown="Tab_MouseDown"
                  ContextMenuOpening="Tab_ContextMenuOpening">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="重新加载" Click="TabMenu_Reload" />
                        <MenuItem Header="复制标签页" Click="TabMenu_Duplicate" />
                        <MenuItem Tag="Mute" Header="静音/取消静音" Click="TabMenu_Mute" />
                        <Separator />
                        <MenuItem Header="关闭标签页" InputGestureText="Ctrl+W" Click="TabMenu_Close" />
                        <MenuItem Header="关闭其他标签页" Click="TabMenu_CloseOthers" />
                        <MenuItem Header="关闭右侧标签页" Click="TabMenu_CloseRight" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Border x:Name="TabBackground"
                        Background="Transparent"
                        CornerRadius="9,9,0,0"
                        Padding="10,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="TabSeparator"
                                Grid.Column="0"
                                Width="1"
                                Height="15"
                                Margin="0,0,9,0"
                                Background="{DynamicResource DividerBrush}"
                                Opacity="0.55"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />

                        <Grid Width="16" Height="16" Margin="1,0,9,0" VerticalAlignment="Center">
                            <TextBlock x:Name="GlobeIcon"
                                       Text="&#xE774;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource IconBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <Image x:Name="FaviconImage"
                                   Source="{Binding Favicon}"
                                   Width="16"
                                   Height="16"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Effect>
                                    <DropShadowEffect BlurRadius="2.5" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                                </Image.Effect>
                            </Image>
                            <Ellipse x:Name="TabSpinner"
                                     Width="13"
                                     Height="13"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="1.8"
                                     StrokeDashArray="2 3"
                                     RenderTransformOrigin="0.5,0.5"
                                     Visibility="Collapsed">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="TabSpinnerRotate" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0"
                                                                 To="360"
                                                                 Duration="0:0:0.85" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>

                        <TextBlock x:Name="TabTitle"
                                   Grid.Column="1"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Foreground="{DynamicResource TabTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />

                        <TextBlock x:Name="AudioIcon"
                                   Grid.Column="2"
                                   Text="&#xE767;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource IconBrush}"
                                   Margin="5,0,1,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock x:Name="MutedIcon"
                                   Grid.Column="2"
                                   Text="&#xE74F;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource IconBrush}"
                                   Margin="5,0,1,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button x:Name="TabCloseButton"
                                Grid.Column="3"
                                Style="{StaticResource TabCloseButtonStyle}"
                                Content="&#xE8BB;"
                                Opacity="0"
                                IsHitTestVisible="False"
                                ToolTip="关闭标签页"
                                Click="TabClose_Click" />
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TabRoot}" Value="True">
                    <Setter TargetName="TabBackground" Property="Background" Value="{DynamicResource TabHoverBrush}" />
                    <Setter TargetName="TabSeparator" Property="Opacity" Value="0" />
                    <Setter TargetName="TabCloseButton" Property="Opacity" Value="0.62" />
                    <Setter TargetName="TabCloseButton" Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabBackground" Property="Background" Value="Transparent" />
                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TabTextActiveBrush}" />
                    <Setter TargetName="TabTitle" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="TabSeparator" Property="Opacity" Value="0" />
                    <Setter TargetName="TabCloseButton" Property="Opacity" Value="0.62" />
                    <Setter TargetName="TabCloseButton" Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TabBackground" Property="Background" Value="Transparent" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                    <Setter TargetName="GlobeIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FaviconImage" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter TargetName="TabSpinner" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FaviconImage" Property="Opacity" Value="0" />
                    <Setter TargetName="GlobeIcon" Property="Opacity" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="BookmarkTemplate">
            <Button Style="{StaticResource BookmarkButtonStyle}"
                    Click="Bookmark_Click"
                    ToolTip="{Binding Url}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开" Click="BookmarkMenu_Open" />
                        <MenuItem Header="在新标签页中打开" Click="BookmarkMenu_OpenNewTab" />
                        <MenuItem Header="在新窗口中打开" Click="BookmarkMenu_OpenNewWindow" />
                        <Separator />
                        <MenuItem Header="修改…" Click="BookmarkMenu_Edit" />
                        <MenuItem Header="删除" Click="BookmarkMenu_Delete" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Orientation="Horizontal" MaxWidth="190">
                    <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BookmarkGlobe"
                                   Text="&#xE774;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource IconBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image x:Name="BookmarkIcon"
                               Source="{Binding Favicon}"
                               Width="16"
                               Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.65" Color="#000000" />
                            </Image.Effect>
                        </Image>
                    </Grid>
                    <TextBlock Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasFavicon}" Value="False">
                    <Setter TargetName="BookmarkGlobe" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BookmarkIcon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFavicon}" Value="True">
                    <Setter TargetName="BookmarkGlobe" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BookmarkIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DownloadTemplate">
            <Grid Margin="14,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8"
                        Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding StateGlyph}"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="15"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,8,0">
                    <TextBlock Text="{Binding FileName}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" · "
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding ProgressText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding SpeedText}"
                                   FontSize="11"
                                   Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <ProgressBar Height="3"
                                 Margin="0,6,0,0"
                                 Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Style="{StaticResource ThinProgressBarStyle}"
                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource ToolbarSubtleButtonStyle}"
                            Width="26" Height="26" FontSize="13"
                            Content="&#xE8E5;"
                            ToolTip="打开"
                            IsEnabled="{Binding CanOpen}"
                            Click="Download_Open" />
                    <Button Style="{StaticResource ToolbarSubtleButtonStyle}"
                            Width="26" Height="26" FontSize="13"
                            Content="&#xE8B7;"
                            ToolTip="在文件夹中显示"
                            IsEnabled="{Binding CanShowInFolder}"
                            Click="Download_ShowInFolder" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SuggestionTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding IconGlyph}"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="15"
                           Foreground="{DynamicResource IconBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Detail}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="0,1,0,0" />
                </StackPanel>
                <Border Grid.Column="2"
                        Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="4"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsSearch, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="搜索"
                               FontSize="10"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
    <Border x:Name="WindowFrame"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="ChromeRoot" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tab strip / title bar -->
                <Grid x:Name="TabStripPanel"
                      Grid.Row="0"
                      Background="{DynamicResource TabStripBrush}"
                      MouseLeftButtonDown="Titlebar_MouseLeftButtonDown"
                      MouseRightButtonUp="Titlebar_MouseRightButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer x:Name="TabsScrollViewer"
                                  Grid.Column="0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Focusable="False"
                                  AllowDrop="True"
                                  DragOver="Tabs_DragOver"
                                  Drop="Tabs_Drop"
                                  SizeChanged="TabsScrollViewer_SizeChanged">
                        <StackPanel Orientation="Horizontal">
                            <Grid x:Name="TabsGrid">
                                <ItemsControl x:Name="TabsItems"
                                              Margin="8,0,0,0"
                                              ItemsSource="{Binding Tabs}"
                                              ItemTemplate="{StaticResource TabTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <Border x:Name="ActiveTabIndicator"
                                        Height="32"
                                        Width="220"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="0,7,0,1"
                                        CornerRadius="10"
                                        Background="{DynamicResource AccentBrush}"
                                        Opacity="0.24"
                                        IsHitTestVisible="False"
                                        Panel.ZIndex="-1"
                                        Visibility="Collapsed"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="ActiveTabIndicatorTranslate" />
                                            <ScaleTransform x:Name="ActiveTabIndicatorScale" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Button x:Name="NewTabButton"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Width="28" Height="28"
                                    Margin="5,7,0,0"
                                    FontSize="13"
                                    Content="&#xE710;"
                                    ToolTip="新建标签页 (Ctrl+T)"
                                    Click="NewTab_Click" />
                            <Button x:Name="TabChevronButton"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Width="20" Height="28"
                                    Margin="0,7,0,0"
                                    FontSize="8"
                                    Content="&#xE70D;"
                                    ToolTip="新建窗口"
                                    Click="TabChevron_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                Content="&#xE921;"
                                ToolTip="最小化"
                                Click="Minimize_Click" />
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="Maximize_Click">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseCaptionButtonStyle}"
                                Content="&#xE8BB;"
                                ToolTip="关闭"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>

                <!-- Toolbar -->
                <Grid x:Name="ToolbarPanel" Grid.Row="1" Background="{DynamicResource ToolbarBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="7,0,3,0" VerticalAlignment="Center">
                        <Button x:Name="BackButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="&#xE72B;"
                                ToolTip="后退 (Alt+←)"
                                IsEnabled="{Binding ActiveTab.CanGoBack}"
                                Click="Back_Click" />
                        <Button x:Name="ForwardButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="&#xE72A;"
                                ToolTip="前进 (Alt+→)"
                                IsEnabled="{Binding ActiveTab.CanGoForward}"
                                Click="Forward_Click" />
                        <Button x:Name="ReloadButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="重新加载 (Ctrl+R)"
                                Click="Reload_Click">
                            <Grid>
                                <TextBlock x:Name="ReloadGlyph" Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="17" />
                                <TextBlock x:Name="StopGlyph" Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="15" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button x:Name="HomeButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="&#xE80F;"
                                FontSize="17"
                                ToolTip="主页 (Alt+Home)"
                                Visibility="{Binding ShowHomeButtonVisibility}"
                                Click="Home_Click" />
                    </StackPanel>

                    <Border x:Name="OmniboxBorder"
                            Grid.Column="1"
                            Height="34"
                            Margin="5,0,8,0"
                            VerticalAlignment="Center"
                            CornerRadius="17"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{DynamicResource OmniboxBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource OmniboxBorderBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource OmniboxFocusBorderBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource OmniboxBackgroundBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="SecurityButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="32" Height="30"
                                    Margin="2,0,0,0"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="13"
                                    Content="&#xE774;"
                                    ToolTip="查看网站信息"
                                    Click="SecurityButton_Click" />

                            <Grid Grid.Column="1">
                                <TextBox x:Name="AddressBox"
                                         VerticalContentAlignment="Center"
                                         FontSize="13.5"
                                         Padding="2,0,2,0"
                                         TextChanged="AddressBox_TextChanged"
                                         GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                                         LostKeyboardFocus="AddressBox_LostKeyboardFocus"
                                         KeyDown="AddressBox_KeyDown"
                                         PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown" />
                                <TextBlock x:Name="AddressPlaceholder"
                                           Text="{Binding OmniboxPlaceholder}"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="13"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=AddressBox, Converter={StaticResource ShowWhenEmpty}}" />
                            </Grid>

                            <Button x:Name="BookmarkStarButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    Grid.Column="2"
                                    Width="30" Height="30"
                                    Margin="0,0,3,0"
                                    FontFamily="{StaticResource IconFont}"
                                    FontSize="15"
                                    Content="&#xE734;"
                                    ToolTip="为此页面添加书签 (Ctrl+D)"
                                    Click="BookmarkStar_Click" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Button x:Name="ExtensionsButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="扩展程序"
                                PreviewMouseDown="PopupButton_PreviewMouseDown"
                                Click="ExtensionsButton_Click">
                            <Viewbox Width="17" Height="17">
                                <Path Data="{StaticResource PuzzleIconGeometry}"
                                      Fill="{DynamicResource IconBrush}"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Button>
                        <Grid>
                            <Button x:Name="DownloadsButton"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Content="&#xE896;"
                                    FontSize="17"
                                    ToolTip="下载内容 (Ctrl+J)"
                                    PreviewMouseDown="PopupButton_PreviewMouseDown"
                                    Click="DownloadsButton_Click" />
                            <Border x:Name="DownloadBadge"
                                    Style="{StaticResource BadgeStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,3,2,0"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding ActiveDownloadCount, Converter={StaticResource CountToVisibility}}">
                                <TextBlock x:Name="DownloadBadgeText"
                                           Text="{Binding ActiveDownloadCount}"
                                           FontSize="9"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <Button x:Name="ProfileButton"
                                Style="{StaticResource IconButtonStyle}"
                                Width="34" Height="34"
                                Margin="3,0"
                                ToolTip="个人资料"
                                PreviewMouseDown="PopupButton_PreviewMouseDown"
                                Click="ProfileButton_Click">
                            <Border Width="25" Height="25" CornerRadius="13" Background="{DynamicResource AccentBrush}">
                                <TextBlock x:Name="ProfileInitial"
                                           Text="X"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Button>
                        <Button x:Name="MenuButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Content="&#xE712;"
                                FontSize="18"
                                ToolTip="自定义及控制 XR Browser"
                                PreviewMouseDown="PopupButton_PreviewMouseDown"
                                Click="MenuButton_Click" />
                    </StackPanel>

                    <ProgressBar x:Name="LoadingBar"
                                 Grid.ColumnSpan="3"
                                 VerticalAlignment="Bottom"
                                 Style="{StaticResource ThinProgressBarStyle}"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />
                </Grid>

                <!-- Bookmarks bar -->
                <Grid x:Name="BookmarksBar"
                      Grid.Row="2"
                      Height="34"
                      Background="{DynamicResource ToolbarBrush}"
                      Visibility="{Binding BookmarksBarVisibility}">
                    <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource DividerBrush}" Opacity="0.55" />
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Padding="8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Bookmarks}"
                                          ItemTemplate="{StaticResource BookmarkTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="书签栏为空 · 点击地址栏中的星标添加常用网站"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding HasBookmarks, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Find bar (a separate strip because the WebView is a native child window) -->
            <Grid Grid.Row="1" Background="{DynamicResource ContentBackgroundBrush}">
                <Border x:Name="FindBar"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,6,18,8"
                        Width="420"
                        Style="{StaticResource PopupSurfaceStyle}"
                        Visibility="Collapsed"
                        Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource IconBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,9,0" />
                        <TextBox x:Name="FindBox"
                                 Grid.Column="1"
                                 Style="{StaticResource FindTextBoxStyle}"
                                 VerticalContentAlignment="Center"
                                 FontSize="13.5"
                                 TextChanged="FindBox_TextChanged"
                                 KeyDown="FindBox_KeyDown" />
                        <TextBlock x:Name="FindResult"
                                   Grid.Column="2"
                                   Text="0/0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,4,0" />
                        <Button Grid.Column="3"
                                Style="{StaticResource ToolbarSubtleButtonStyle}"
                                Width="28" Height="28" FontSize="12"
                                Content="&#xE70E;"
                                ToolTip="上一个 (Shift+Enter)"
                                Click="FindPrevious_Click" />
                        <Button Grid.Column="4"
                                Style="{StaticResource ToolbarSubtleButtonStyle}"
                                Width="28" Height="28" FontSize="12"
                                Content="&#xE70D;"
                                ToolTip="下一个 (Enter)"
                                Click="FindNext_Click" />
                        <Button Grid.Column="5"
                                Style="{StaticResource ToolbarSubtleButtonStyle}"
                                Width="28" Height="28" FontSize="10"
                                Content="&#xE8BB;"
                                ToolTip="关闭 (Esc)"
                                Click="FindClose_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Web content -->
            <Grid x:Name="ContentRoot" Grid.Row="2" Background="{DynamicResource ContentBackgroundBrush}" ClipToBounds="True" SizeChanged="ContentRoot_SizeChanged">
                <Grid x:Name="TabsHost" />

                <Grid x:Name="StartupOverlay" Background="{DynamicResource ContentBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="84" Height="84" CornerRadius="24" HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4C8DF6" Offset="0" />
                                    <GradientStop Color="#7B5CFA" Offset="0.55" />
                                    <GradientStop Color="#E85D9E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="XR"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="XR Browser"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0" />
                        <TextBlock Text="正在启动 Chromium 引擎…"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,7,0,0" />
                        <ProgressBar Width="180" Height="3" Margin="0,22,0,0"
                                     Style="{StaticResource ThinProgressBarStyle}"
                                     IsIndeterminate="True" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="CrashOverlay"
                      Background="{DynamicResource ContentBackgroundBrush}"
                      Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="48"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="此页面崩溃了"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0" />
                        <TextBlock Text="内存不足或网页的渲染进程意外终止。你可以重新加载此页面，或关闭它。"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Style="{StaticResource AccentButtonStyle}" Content="重新加载" Click="CrashReload_Click" />
                            <Button Style="{StaticResource SubtleButtonStyle}" Content="关闭标签页" Margin="8,0,0,0" Click="CrashClose_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>

    <!-- Omnibox suggestions -->
    <Popup x:Name="OmniboxPopup"
           PlacementTarget="{Binding ElementName=OmniboxBorder}"
           Placement="Bottom"
           VerticalOffset="5"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <Border x:Name="OmniboxPopupBorder"
                Margin="0,0,0,10"
                Style="{StaticResource PopupSurfaceStyle}"
                Padding="0,5">
            <ListBox x:Name="SuggestionList"
                     Style="{StaticResource SuggestionListStyle}"
                     ItemsSource="{Binding Suggestions}"
                     ItemTemplate="{StaticResource SuggestionTemplate}"
                     MaxHeight="430"
                     PreviewMouseLeftButtonUp="SuggestionList_PreviewMouseLeftButtonUp"
                     PreviewMouseMove="SuggestionList_PreviewMouseMove" />
        </Border>
    </Popup>

    <!-- Main menu -->
    <Popup x:Name="MainMenuPopup"
           PlacementTarget="{Binding ElementName=MenuButton}"
           Placement="Bottom"
           HorizontalOffset="-292"
           VerticalOffset="8"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <Border Width="326" Margin="10" Style="{StaticResource PopupSurfaceStyle}" Padding="0,6">
            <StackPanel>
                <Grid Margin="16,10,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="X" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="本地个人资料" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="浏览数据仅保存在此设备" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource PopupSeparatorStyle}" />

                <Button Style="{StaticResource MenuRowButtonStyle}" Click="NewTab_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE710;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="新建标签页" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="Ctrl+T" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="NewWindow_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE737;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="新建窗口" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="Ctrl+N" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="NewIncognitoWindow_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE727;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="新建无痕窗口" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="Ctrl+Shift+N" />
                    </Grid>
                </Button>

                <Border Style="{StaticResource PopupSeparatorStyle}" />

                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenHistory_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE81C;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="历史记录" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="Ctrl+H" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenBookmarks_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE8A4;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="书签和清单" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="Ctrl+Shift+O" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenDownloads_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE896;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="下载内容" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="Ctrl+J" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenExtensions_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="22" Height="18" VerticalAlignment="Center">
                            <Viewbox Width="17" Height="17" HorizontalAlignment="Left">
                                <Path Data="{StaticResource PuzzleIconGeometry}"
                                      Fill="{DynamicResource IconBrush}"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Grid>
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="扩展程序" />
                    </Grid>
                </Button>

                <Border Style="{StaticResource PopupSeparatorStyle}" />

                <Grid Height="40" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE71E;" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="缩放" />
                    <Button Grid.Column="2" Style="{StaticResource ToolbarSubtleButtonStyle}" Width="24" Height="24" FontSize="14" Content="&#xE738;" Click="ZoomOut_Click" ToolTip="缩小" />
                    <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Width="56" Height="26" Padding="0" FontSize="11.5" ToolTip="重置缩放" Click="ResetZoom_Click">
                        <TextBlock Text="{Binding ActiveTab.ZoomPercent, FallbackValue=100%}" />
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource ToolbarSubtleButtonStyle}" Width="24" Height="24" FontSize="14" Content="&#xE710;" Click="ZoomIn_Click" ToolTip="放大" />
                </Grid>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="ToggleFullscreen_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE740;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="进入全屏" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="F11" />
                    </Grid>
                </Button>

                <Border Style="{StaticResource PopupSeparatorStyle}" />

                <Button Style="{StaticResource MenuRowButtonStyle}" Click="Print_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE749;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="打印…" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="Ctrl+P" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="Find_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE721;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="查找…" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="Ctrl+F" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="DevTools_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE943;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="开发者工具" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="F12" />
                    </Grid>
                </Button>

                <Border Style="{StaticResource PopupSeparatorStyle}" />

                <Grid Height="38" Margin="16,0" ToolTip="拦截广告与跟踪请求（AdGuard 过滤列表）">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE72E;" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="AdGuard 广告过滤" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="2"
                                  Style="{StaticResource MiniToggleStyle}"
                                  IsChecked="{Binding AdBlockEnabled, Mode=OneWay}"
                                  VerticalAlignment="Center"
                                  Click="AdBlockToggle_Click"
                                  ToolTip="开启或关闭 AdGuard 广告过滤" />
                </Grid>

                <Grid Height="38" Margin="16,0" ToolTip="使用 Dark Reader 为网页启用深色主题">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE708;" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="Dark Reader" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="2"
                                  Style="{StaticResource MiniToggleStyle}"
                                  IsChecked="{Binding DarkReaderEnabled, Mode=OneWay}"
                                  VerticalAlignment="Center"
                                  Click="DarkReaderToggle_Click"
                                  ToolTip="开启或关闭 Dark Reader" />
                </Grid>

                <Border Style="{StaticResource PopupSeparatorStyle}" />

                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenSettings_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE713;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="设置" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenAbout_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE946;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="关于 XR Browser" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="Exit_Click">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE8BB;" />
                        <TextBlock Grid.Column="1" Style="{StaticResource MenuLabelStyle}" Text="退出" />
                        <TextBlock Grid.Column="2" Style="{StaticResource MenuShortcutStyle}" Text="Alt+F4" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </Popup>

    <!-- Profile menu -->
    <Popup x:Name="ProfilePopup"
           PlacementTarget="{Binding ElementName=ProfileButton}"
           Placement="Bottom"
           HorizontalOffset="-236"
           VerticalOffset="8"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <Border Width="280" Margin="10" Style="{StaticResource PopupSurfaceStyle}" Padding="0,6">
            <StackPanel>
                <Grid Margin="16,10,16,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="X" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="本地个人资料" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="未登录 · 数据仅保存在此设备" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource PopupSeparatorStyle}" />
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenSettings_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE713;" />
                        <TextBlock Style="{StaticResource MenuLabelStyle}" Text="管理个人资料" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="NewIncognitoWindow_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE727;" />
                        <TextBlock Style="{StaticResource MenuLabelStyle}" Text="打开无痕窗口" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource PopupSeparatorStyle}" />
                <TextBlock Text="Chromium 内核 · 本地配置" FontSize="10.5"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="18,7,18,8" />
            </StackPanel>
        </Border>
    </Popup>

    <!-- Downloads menu -->
    <Popup x:Name="DownloadsPopup"
           PlacementTarget="{Binding ElementName=DownloadsButton}"
           Placement="Bottom"
           HorizontalOffset="-326"
           VerticalOffset="8"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <Border Width="370" MaxHeight="460" Margin="10" Style="{StaticResource PopupSurfaceStyle}" Padding="0,6">
            <StackPanel>
                <Grid Margin="16,8,12,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="下载内容" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" FontSize="11.5"
                            Content="全部" Click="OpenDownloads_Click" />
                </Grid>
                <Border Style="{StaticResource PopupSeparatorStyle}" />
                <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Downloads}" ItemTemplate="{StaticResource DownloadTemplate}" />
                </ScrollViewer>
                <TextBlock Text="还没有下载内容"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,26"
                           Visibility="{Binding HasDownloads, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Popup>

    <!-- Extensions menu -->
    <Popup x:Name="ExtensionsPopup"
           PlacementTarget="{Binding ElementName=ExtensionsButton}"
           Placement="Bottom"
           HorizontalOffset="-300"
           VerticalOffset="8"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <Border Width="360" Margin="10" Style="{StaticResource PopupSurfaceStyle}" Padding="0,6">
            <StackPanel>
                <Grid Margin="16,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="扩展程序" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Padding="8,4" FontSize="11.5"
                            Content="管理" Click="OpenExtensions_Click" />
                </Grid>
                <Border Style="{StaticResource PopupSeparatorStyle}" />

                <Border Background="{DynamicResource DangerSoftBrush}"
                        CornerRadius="8"
                        Padding="11,8"
                        Margin="12,8,12,4"
                        Visibility="{Binding ExtensionsDisabledVisibility}">
                    <TextBlock Text="扩展程序支持已关闭。请在设置中开启，然后重启 XR Browser。"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource DangerBrush}" />
                </Border>

                <TextBlock Text="正在读取扩展程序…"
                           Margin="16,12,16,12"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding IsExtensionsLoading, Converter={StaticResource BoolToVisibility}}" />

                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Extensions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="8"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            VerticalAlignment="Center">
                                        <Viewbox Width="15" Height="15">
                                            <Path Data="{StaticResource PuzzleIconGeometry}"
                                                  Fill="{DynamicResource AccentBrush}"
                                                  Stretch="Uniform" />
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding StateText}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2"
                                                  Style="{StaticResource MiniToggleStyle}"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="启用或停用此扩展程序"
                                                  Click="ExtensionToggle_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="还没有安装扩展程序"
                           FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,22"
                           Visibility="{Binding ExtensionsEmptyVisibility}" />

                <TextBlock Text="{Binding ExtensionsError}"
                           FontSize="11"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Margin="16,4,16,8"
                           Visibility="{Binding ExtensionsError, Converter={StaticResource StringToVisibility}}" />

                <Border Style="{StaticResource PopupSeparatorStyle}" />
                <Button Style="{StaticResource MenuRowButtonStyle}"
                        Click="ExtensionsInstallCrx_Click"
                        IsEnabled="{Binding ExtensionsCanInstall}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE8A5;" />
                        <TextBlock Style="{StaticResource MenuLabelStyle}" Text="从 CRX 文件安装…" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="ExtensionsLoad_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE8B7;" />
                        <TextBlock Style="{StaticResource MenuLabelStyle}" Text="加载已解压的扩展程序" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="OpenExtensions_Click">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="22" Height="18" VerticalAlignment="Center">
                            <Viewbox Width="17" Height="17" HorizontalAlignment="Left">
                                <Path Data="{StaticResource PuzzleIconGeometry}"
                                      Fill="{DynamicResource IconBrush}"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Grid>
                        <TextBlock Style="{StaticResource MenuLabelStyle}" Text="管理扩展程序" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Popup>

    <!-- Site information -->
    <Popup x:Name="SiteInfoPopup"
           PlacementTarget="{Binding ElementName=SecurityButton}"
           Placement="Bottom"
           HorizontalOffset="-10"
           VerticalOffset="8"
           StaysOpen="False"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <Border Width="330" Margin="10" Style="{StaticResource PopupSurfaceStyle}" Padding="16,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock x:Name="SiteInfoGlyph" Text="&#xE72E;"
                                   FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SiteInfoTitle" Text="连接安全" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SiteInfoHost" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="SiteInfoDescription"
                           Text="此网站使用安全连接。"
                           TextWrapping="Wrap" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,12,0,0" />
                <Border Style="{StaticResource PopupSeparatorStyle}" />
                <Button Style="{StaticResource MenuRowButtonStyle}" Click="SiteInfoClearData_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE74D;" />
                        <TextBlock Style="{StaticResource MenuLabelStyle}" Text="清除此网站的数据" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Popup>

    <!-- Native WebView airspace workaround: status and toast use top-level popups. -->
    <Popup x:Name="StatusPopup"
           PlacementTarget="{Binding ElementName=ContentRoot}"
           Placement="Relative"
           StaysOpen="True"
           AllowsTransparency="True"
           Focusable="False">
        <Border x:Name="StatusPill"
                Padding="10,5"
                CornerRadius="6"
                Background="{DynamicResource StatusBackgroundBrush}"
                Opacity="0.94"
                IsHitTestVisible="False">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource StatusTextBrush}"
                       FontSize="11.5"
                       MaxWidth="760"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Popup>

    <Popup x:Name="ToastPopup"
           PlacementTarget="{Binding ElementName=ContentRoot}"
           Placement="Relative"
           StaysOpen="True"
           AllowsTransparency="True"
           Focusable="False">
        <Border x:Name="ToastBorder"
                Padding="16,11"
                CornerRadius="8"
                Background="{DynamicResource StatusBackgroundBrush}"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText"
                       Foreground="{DynamicResource StatusTextBrush}"
                       FontSize="12.5" />
        </Border>
    </Popup>
    </Grid>
</Window>
