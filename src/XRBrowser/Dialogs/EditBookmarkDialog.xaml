<Window x:Class="XRBrowser.Dialogs.EditBookmarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改书签"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Border Background="{DynamicResource MenuBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.25" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="修改书签" FontSize="18" FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="10"
                            Content="&#xE8BB;"
                            Click="Cancel_Click" />
                </Grid>

                <TextBlock Text="名称" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,20,0,6" />
                <TextBox x:Name="TitleBox"
                         Height="38"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource OmniboxBackgroundBrush}"
                         BorderBrush="{DynamicResource DividerBrush}"
                         BorderThickness="1"
                         FontSize="13" />

                <TextBlock Text="网址" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,6" />
                <TextBox x:Name="UrlBox"
                         Height="38"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource OmniboxBackgroundBrush}"
                         BorderBrush="{DynamicResource DividerBrush}"
                         BorderThickness="1"
                         FontSize="13" />

                <TextBlock x:Name="ErrorText"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="11.5"
                           Margin="0,10,0,0"
                           Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Style="{StaticResource SubtleButtonStyle}" Content="取消" MinWidth="76" Click="Cancel_Click" />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="保存" MinWidth="82" Margin="10,0,0,0" Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
