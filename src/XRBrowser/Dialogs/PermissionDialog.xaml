<Window x:Class="XRBrowser.Dialogs.PermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网站权限"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20">
        <Border Background="{DynamicResource MenuBackgroundBrush}"
                BorderBrush="{DynamicResource PopupBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.25" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="网站权限" FontSize="18" FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButtonStyle}"
                            Width="30" Height="30"
                            FontFamily="{StaticResource IconFont}"
                            FontSize="10"
                            Content="&#xE8BB;"
                            Click="Block_Click" />
                </Grid>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock x:Name="PermissionGlyph"
                                   Text="&#xE7BA;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="19"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PermissionTitle" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="SiteName" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="PermissionDescription"
                           TextWrapping="Wrap"
                           FontSize="12.5"
                           LineHeight="20"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,18,0,0" />

                <Border Background="{DynamicResource HoverBrush}" CornerRadius="8" Padding="11,8" Margin="0,14,0,0">
                    <TextBlock Text="你可以随时在设置中清除此网站的权限。"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource SubtleButtonStyle}" Content="阻止" MinWidth="80" Click="Block_Click" />
                    <Button Style="{StaticResource AccentButtonStyle}" Content="允许" MinWidth="86" Margin="10,0,0,0" Click="Allow_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
